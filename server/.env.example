# LocalHire Backend - Environment Variables Template
# Copy this file to .env and configure values for your environment.
# Never commit the actual .env file or real secrets to version control.

# ── Server Configuration ──────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5500

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:5500

# ── Authentication (JWT Secret) ───────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# ── Hosted Supabase API Configuration ─────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=replace_with_your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_secret_key

# ── Hosted Supabase PostgreSQL Database (Prisma) ──────────────
# Obtain in Supabase Dashboard → Connect → Connection string → URI
# Connection Pooler (port 6543) for runtime queries:
DATABASE_URL=postgresql://postgres.your-project-id:your_db_password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection (port 5432) for migrations:
DIRECT_URL=postgresql://postgres.your-project-id:your_db_password@aws-0-region.pooler.supabase.com:5432/postgres

# ── Razorpay Payment Gateway Configuration ────────────────────
# Obtain in Razorpay Dashboard → Settings → API Keys
# Public Key ID (rzp_test_... in test mode, rzp_live_... in production):
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
# Private Secret Key used for HMAC SHA256 payment signature verification:
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_secret_key
# Webhook secret configured in Razorpay Dashboard → Settings → Webhooks (for /api/escrow/razorpay/webhook):
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret

# ── Escrow Payment Mode ────────────────────────────────────────
# Controls the escrow state machine and gateway processing:
# - 'LIVE': Uses real/test Razorpay gateway; verifies signatures with HMAC SHA256. Requires valid RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET.
# - 'SIMULATED': Local development sandbox only (rejected in production). Allows simulated payments without external network calls.
ESCROW_PAYMENT_MODE=LIVE

# ── Seed Admin Credentials (Optional) ─────────────────────────
# Used when running `npm run prisma:seed` to provision an Admin user
ADMIN_EMAIL=admin@localhire.dev
ADMIN_PASSWORD=replace_with_a_secure_admin_password

